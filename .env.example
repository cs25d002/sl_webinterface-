FRONTEND_PORT=5173
BACKEND_PORT=4000
VITE_API_BASE_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# Optional: override a hospital service's deployment URL without editing
# backend/src/config/hospitals.json. Naming convention:
#   SERVICE_URL_<HOSPITAL_SLUG>_<SERVICE_SLUG>  (slug hyphens -> underscores, uppercased)
# All of these are optional — leave unset to use the JSON-configured URL.
# SERVICE_URL_SVIMS_ANNOTATION_TOOL=
# SERVICE_URL_SVIMS_CLINICIAN_INTERFACE=
# SERVICE_URL_SVIMS_PII_MASKING=
# SERVICE_URL_MANIPAL_MANGALORE_ANNOTATION_TOOL=
# SERVICE_URL_MANIPAL_MANGALORE_PATIENT_RECORD_TEXT_EXTRACTION=
# SERVICE_URL_CHITTOOR_GENERAL_HOSPITAL_DISCHARGE_SUMMARY_TEXT_EXTRACTION=
